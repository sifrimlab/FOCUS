# ── FOCUS Singularity / Apptainer definition ─────────────────────────────────
#
# CPU-only PyTorch is baked in by default. For a CUDA build pass the
# TORCH_INDEX build arg (Apptainer >= 1.1 / SingularityCE >= 3.11):
#
# Build (CPU — default):
#   singularity build --build-arg TORCH_INDEX=https://download.pytorch.org/whl/cpu focus.sif focus.def
#   apptainer  build --build-arg TORCH_INDEX=https://download.pytorch.org/whl/cpu focus.sif focus.def
#   # (a bare `apptainer build focus.sif focus.def` also works and defaults to CPU)
#
# Build (GPU — pick the index matching your target CUDA, e.g. CUDA 12.8+):
#   apptainer build --build-arg TORCH_INDEX=https://download.pytorch.org/whl/cu128 focus.sif focus.def
#   # other indices: cu126, cu124, cu121, cu118 — see install.sh resolve_torch_index
#   # The cuXXX wheel bundles CUDA internally; pass --nv at runtime for GPU access.
#
# Plain build (requires root or --fakeroot):
#   singularity build focus.sif focus.def
#   apptainer build focus.sif focus.def
#
# Run (GUI):
#   singularity run --bind /your/data -p 5050:5050 focus.sif
#   apptainer run  --bind /your/data focus.sif
#
# Run (CLI):
#   singularity run --bind /your/data focus.sif --config /your/data/project/config.json
#
# Note: Singularity/Apptainer automatically bind-mounts $HOME and /tmp.
# Use --bind /path to add additional directories at the same path inside
# the container — no directory translation required in config files.

Bootstrap: docker
From: python:3.11-slim

%labels
    Author  Lorenzo Venturelli
    Version 0.1.0
    Description FOCUS — Flexible Multiomics data preprocessing, alignment and registration

%environment
    export PATH=/opt/focus-env/bin:$PATH
    export PYTHONPATH=/opt/focus/src:$PYTHONPATH

%files
    requirements.txt  /opt/focus/requirements.txt
    pyproject.toml    /opt/focus/pyproject.toml
    src               /opt/focus/src

%post
    # System dependencies
    apt-get update && apt-get install -y --no-install-recommends \
        libgl1 \
        libglib2.0-0 \
        libgomp1 \
        libsm6 \
        libxext6 \
    && rm -rf /var/lib/apt/lists/*

    # Create a dedicated venv so binaries are on a known PATH
    python3 -m venv /opt/focus-env
    /opt/focus-env/bin/pip install --no-cache-dir --upgrade pip

    # Install the general dependencies
    /opt/focus-env/bin/pip install --no-cache-dir -r /opt/focus/requirements.txt

    # ── PyTorch ecosystem (torch, torchvision, timm, huggingface-hub) ────────
    # Installed from the wheel index in TORCH_INDEX (build arg, default CPU),
    # NOT from requirements.txt — same strategy as install.sh. On older
    # Singularity without build-arg support the {{ }} template stays literal,
    # so anything that is not a pytorch.org URL falls back to the CPU index.
    TORCH_INDEX="{{ TORCH_INDEX }}"
    case "$TORCH_INDEX" in
        *download.pytorch.org*) : ;;
        *) TORCH_INDEX="https://download.pytorch.org/whl/cpu" ;;
    esac
    echo "FOCUS: installing PyTorch from ${TORCH_INDEX}"
    /opt/focus-env/bin/pip install --no-cache-dir torch torchvision --index-url "${TORCH_INDEX}"
    /opt/focus-env/bin/pip show torch       | awk '/^Version:/ {print "torch=="$2}'       >  /tmp/torch-constraints.txt
    /opt/focus-env/bin/pip show torchvision | awk '/^Version:/ {print "torchvision=="$2}' >> /tmp/torch-constraints.txt
    /opt/focus-env/bin/pip install --no-cache-dir timm huggingface-hub -c /tmp/torch-constraints.txt
    rm -f /tmp/torch-constraints.txt

    # Install the FOCUS package
    /opt/focus-env/bin/pip install --no-cache-dir -e /opt/focus

%runscript
    exec /opt/focus-env/bin/focus "$@"

%startscript
    exec /opt/focus-env/bin/focus "$@"

%help
    FOCUS: Flexible Multiomics data preprocessing, alignment and registration.

    Usage
    -----
    Launch GUI (opens http://localhost:5050):
        singularity run --bind /your/data focus.sif

    CLI mode:
        singularity run --bind /your/data focus.sif --config /your/data/project/config.json

    The --bind flag maps the given host directory into the container at the
    *same absolute path*, so all paths in your config file stay unchanged.

    On HPC clusters without outbound port access use SSH port-forwarding:
        ssh -L 5050:localhost:5050 <cluster-host>
    then open http://localhost:5050 in your local browser.