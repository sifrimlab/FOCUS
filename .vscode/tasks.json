{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Run Dev Server",
			"type": "shell",
			"command": "npm run dev",
			"options": {
				"cwd": "${workspaceFolder}/src/GUI/Direct Mapping GUI"
			},
			"isBackground": true,
			"problemMatcher": [
				"$vite"
			],
			"group": "test"
		},
		{
			"label": "Build Vue App",
			"type": "shell",
			"command": "npm run build",
			"options": {
				"cwd": "${workspaceFolder}/src/GUI/Direct Mapping GUI"
			},
			"group": "build",
			"problemMatcher": []
		}
	]
}