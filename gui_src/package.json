{
  "name": "focus-gui",
  "private": true,
  "type": "module",
  "description": "FOCUS web GUIs: the main orchestration app, the manual alignment app, and their shared design system.",
  "engines": {
    "node": ">=22.12"
  },
  "workspaces": [
    "shared",
    "main",
    "alignment"
  ],
  "scripts": {
    "build": "npm run build -w main -w alignment",
    "lint:design": "npm run lint:design -ws --if-present",
    "test": "npm test -ws --if-present"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.2",
    "@types/node": "^24.10.1",
    "@vitejs/plugin-vue": "6.0.5",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.8.1",
    "autoprefixer": "10.4.27",
    "jsdom": "^29.1.1",
    "postcss": "8.5.8",
    "tailwindcss": "4.2.2",
    "typescript": "5.9.3",
    "vite": "7.3.1",
    "vitest": "^3.2.7",
    "vue-tsc": "3.2.6"
  },
  "overrides": {
    "vue": "3.5.31",
    "tailwindcss": "4.2.2"
  }
}
